# Public origin used for Open Graph, sitemap, robots, and JSON-LD.
# Set this before `next build` so metadata matches the deployment.
NEXT_PUBLIC_SITE_URL=https://soundstack.vercel.app

# Resend. The newsletter route adds the address to this audience.
# Audiences were renamed to Segments in the Resend dashboard; put the
# audience id here. If that legacy call is rejected, the route retries
# with the same id as a segment.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Stripe Payment Link URL (https://buy.stripe.com/...). The header CTA
# "Feature Your Plugin / Pack ($149)" is hidden when this is unset.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Webhook signing secret (whsec_...). Required for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Optional. Signature verification does not call the Stripe API.
# Set this later if you persist sponsors with the Stripe API.
STRIPE_SECRET_KEY=
