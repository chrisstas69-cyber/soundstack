# Copy to .env.local for development. On Vercel, set the same keys in Project Settings → Environment Variables.
# NEXT_PUBLIC_* values are inlined at build time. Set them before building.

# Public site origin used for sitemap, robots, Open Graph, and JSON-LD.
# Example: https://soundstack.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend. Both are required for POST /api/newsletter.
# The route calls resend.contacts.create({ audienceId }). Resend has renamed
# audiences to segments; this legacy audience id still works in the SDK.
# If either variable is missing, the route returns 503 and does not throw.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Stripe Payment Link for the "Feature Your Plugin / Pack ($149)" button.
# Leave blank to render the button disabled.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Webhook signing secret for POST /api/stripe/webhook (whsec_...).
# Signature checks use this value only. A Stripe secret key is not required.
# If this is missing, the route returns 503.
STRIPE_WEBHOOK_SECRET=
