# Public origin used for Open Graph, sitemap, robots, and JSON-LD.
# Set this before `next build` so metadata matches the deployment.
NEXT_PUBLIC_SITE_URL=https://soundstack.vercel.app

# Resend. The newsletter route adds the address to this audience.
# Audiences were renamed to Segments in the Resend dashboard; put the
# audience id here. If that legacy call is rejected, the route retries
# with the same id as a segment.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Sponsor emails. OWNER_ALERT_EMAIL receives "You made $79 from ..."
# using the Checkout Session total (a $149 payment says $149).
# RESEND_FROM defaults to onboarding@resend.dev, which can only deliver
# to the Resend account email. Set RESEND_FROM to a verified domain
# address before buyer confirmations can reach customers.
OWNER_ALERT_EMAIL=
RESEND_FROM=

# Bearer token for GET/POST /api/sponsors/active (newsletter inclusion).
ADMIN_TOKEN=

# Founding Stripe Payment Link ($79, first 5 sponsors, 7 days).
# When this is an https URL, the header CTA is
# "Feature Your Plugin ($79 founding, reg. $149)".
NEXT_PUBLIC_STRIPE_FOUNDING_LINK=

# Standard Stripe Payment Link ($149, 7 days). The header uses this
# when the founding link is unset.
NEXT_PUBLIC_STRIPE_FULL_LINK=

# Legacy Payment Link. On production this currently points at the
# founding checkout. The header uses it only when both links above
# are unset. The CTA is hidden when no link is an https URL.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Webhook signing secret (whsec_...). Required for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Optional. Signature verification does not call the Stripe API.
# Sponsor persistence reads the webhook payload, not the Stripe API.
STRIPE_SECRET_KEY=

# Private Vercel Blob store for featured sponsors (sponsors/featured.json).
# On Vercel, connect a private Blob store to this project. That sets
# BLOB_STORE_ID. Vercel also injects VERCEL_OIDC_TOKEN at runtime.
# Outside Vercel, set BLOB_READ_WRITE_TOKEN instead. Leave both empty
# locally: the radar still works, and the webhook returns 500 until a
# store is configured so Stripe can retry.
# Tests and `next dev` can set SPONSOR_STORE=memory instead. That store
# is ignored when NODE_ENV=production.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
